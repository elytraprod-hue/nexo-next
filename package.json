{
  "name": "nexo-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node scripts/smoke.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:smoke && npm run build",
    "db:push": "npx supabase db push",
    "deploy:check": "npm run verify",
    "deploy:prod": "npm run verify && npm run db:push && npx vercel --prod"
  },
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.106.2",
    "clsx": "^2.1.1",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.17.0",
    "next": "^15.5.19",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.77.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "@supabase/ssr": "^0.6.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.5.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.19",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5"
  }
}